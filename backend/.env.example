NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=local_service_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — keep strong secrets in production
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# OTP (use real SMS provider in prod — e.g. Twilio, MSG91)
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Razorpay (keys fetched at runtime only — never in Flutter)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# File uploads
AWS_BUCKET_NAME=localserve-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# App
APP_NAME=LocalServe
SUPPORT_EMAIL=help@localserve.in
PLATFORM_COMMISSION_PERCENT=10
